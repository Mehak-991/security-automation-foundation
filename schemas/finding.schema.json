{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://security-automation-foundation.local/schemas/finding.schema.json",
  "title": "Canonical Security Finding",
  "description": "Common schema used to normalize findings from JSON, XML, and CSV scanner outputs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "asset",
    "endpoint",
    "severity",
    "cvss",
    "cwe",
    "evidence",
    "impact",
    "remediation",
    "references",
    "status",
    "traceability_ids",
    "sources"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "asset": {
      "type": "string",
      "minLength": 1
    },
    "endpoint": {
      "type": "string",
      "minLength": 1
    },
    "severity": {
      "type": "string",
      "enum": [
        "Low",
        "Medium",
        "High",
        "Critical"
      ]
    },
    "cvss": {
      "type": "number",
      "minimum": 0,
      "maximum": 10
    },
    "cwe": {
      "type": "string",
      "pattern": "^CWE-[0-9]+$"
    },
    "evidence": {
      "type": "string",
      "minLength": 1
    },
    "impact": {
      "type": "string",
      "minLength": 1
    },
    "remediation": {
      "type": "string",
      "minLength": 1
    },
    "references": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "Open",
        "Reviewed",
        "Closed",
        "Needs Review"
      ]
    },
    "traceability_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^TRC-(JSON|XML|CSV)-[0-9]{3}$"
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "format",
          "record_id",
          "raw_record"
        ],
        "properties": {
          "format": {
            "type": "string",
            "enum": [
              "JSON",
              "XML",
              "CSV"
            ]
          },
          "record_id": {
            "type": "string",
            "minLength": 1
          },
          "raw_record": {
            "type": "object"
          }
        }
      }
    }
  }
}
